<?xml version="1.0" encoding="utf-8"?>
<!--
  Só HTTPS e só certificados do sistema. Certificados instalados pelo usuário (usados por
  ferramentas de interceptação/proxy) não são aceitos, nem em debug.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
